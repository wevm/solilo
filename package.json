{
  "name": "solilo",
  "version": "0.1.0",
  "description": "Import Solidity and literal Alloy interfaces as typed ABI arrays.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.22.1"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mapper": "./dist/mapper.js",
    "./register": "./dist/register.js",
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "dist/mapper.js"
      ],
      "compilerOptions": [],
      "dynamicConfig": true
    }
  },
  "scripts": {
    "build:wasm": "cargo build --locked --release --target wasm32-unknown-unknown",
    "build": "npm run build:wasm && tsc -p tsconfig.json && node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:types": "tsc -p examples/tsconfig.json --runExternalCode",
    "prepack": "npm run build"
  },
  "dependencies": {
    "abitype": "1.2.3"
  },
  "devDependencies": {
    "typescript": "7.1.0-dev.20261023.1",
    "@types/node": "^24.0.0",
    "viem": "^2.0.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "solc": "0.8.38",
    "@foundry-rs/anvil": "1.7.1",
    "@foundry-rs/forge": "1.7.1"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
