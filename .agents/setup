#!/usr/bin/env bash
set -euo pipefail

if [[ ! -x "$HOME/.cargo/bin/rustup" ]]; then
  installer="$(mktemp)"
  curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs -o "$installer"
  sh "$installer" -y --profile minimal --default-toolchain none
  rm "$installer"
fi
source "$HOME/.cargo/env"
rustup show active-toolchain
package_manager="$(node -p 'require("./package.json").packageManager')"
if [[ "$(pnpm --version 2>/dev/null || true)" != "${package_manager#pnpm@}" ]]; then
  npm install --global "$package_manager"
fi
pnpm install --frozen-lockfile
pnpm run build
cargo fetch --locked --manifest-path tests/oracle/Cargo.toml
